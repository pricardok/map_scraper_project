# =============================================================================
# MAP SCRAPER - arquivo de exemplo de configuração
# -----------------------------------------------------------------------------
# Copie para `.env` e ajuste:
#     Copy-Item .env.example .env
#
# REGRAS IMPORTANTES
#  - Formato: CHAVE=VALOR, uma por linha.
#  - Comentários (linhas que começam com #) podem ficar à vontade, mas SEMPRE em
#    linha própria. Não coloque comentário na mesma linha do valor, porque ele
#    seria lido como parte do valor.
#  - true/false: também aceita 1/0, sim/não, s/yes/on.
#  - O arquivo `.env` NÃO é versionado no Git (contém a API key da WAHA).
# =============================================================================


# =============================================================================
# BANCO DE DADOS — engine independente (PostgreSQL ou DuckDB)
# =============================================================================

# Qual banco usar?
#   duckdb    = banco local (arquivo DUCKDB_PATH). Bom para rodar offline.
#   postgres  = banco externo PostgreSQL (DATABASE_URL).
# Se você DEIXAR ESTA LINHA COMENTADA, o sistema decide sozinho:
#   - se DUCKDB_PATH estiver definido -> usa DuckDB
#   - senão, se DATABASE_URL estiver definido -> usa PostgreSQL
DB_ENGINE=postgres

# ---- Opção 1: PostgreSQL (banco externo) ----------------------------------
# URL de conexão: postgresql://usuario:senha@host:porta/banco
# ATENÇÃO: se a senha tiver caracteres especiais (@, :, /), "percent-encode":
#   @ -> %40
DATABASE_URL=postgresql://usuario:senha@localhost:5432/leads_db

# ---- Opção 2: DuckDB (banco local, para rodar offline) ---------------------
# Para usar o DuckDB, comente/remova o DATABASE_URL acima e descomente a linha:
#DUCKDB_PATH=data/leads.duckdb

# ---- Configuração antiga (referência) --------------------------------------
# As variáveis abaixo foram substituídas por DATABASE_URL. Funcionam se você
# comentar/remover o DATABASE_URL E definir DB_ENGINE=postgres.
#DB_HOST=localhost
#DB_PORT=5432
#DB_NAME=leads_db
#DB_USER=leads_app
#DB_PASSWORD=


# =============================================================================
# WHATSAPP - PROVEDOR DE ENVIO
# =============================================================================
#
#   meta  -> API OFICIAL da Meta / Cloud API  (PADRÃO)
#   waha  -> WAHA (WhatsApp Web não oficial)  (BACKUP manual)
#
# ⚠️ É BACKUP, não fallback: só o provedor escolhido roda. Se a Meta falhar,
# o lead é marcado como 'falhou' — NÃO tentamos a WAHA automaticamente, porque
# isso mascararia problemas (template rejeitado, número banido) e misturaria
# dois canais no mesmo log.
#
# Diferença importante de conteúdo:
#   meta -> envia TEMPLATE APROVADO (o texto do banco NÃO vai para o lead)
#   waha -> envia TEXTO LIVRE (o texto do banco vai como está)
WHATSAPP_PROVIDER=meta


# =============================================================================
# META (API OFICIAL) - usado quando WHATSAPP_PROVIDER=meta
# =============================================================================

# Token permanente (System User) do app Meta. O mesmo que o backend usa.
META_ACCESS_TOKEN=

# Phone Number ID do número oficial (o mesmo do backend).
# +55 51 8151-6260 -> 1121736814366847
META_PHONE_NUMBER_ID=

# Versão da Graph API (opcional).
META_API_VERSION=v25.0

# Template APROVADO na Meta usado na campanha.
# Consulte os disponíveis: GET /{WABA_ID}/message_templates
# Ex.: mkt_01
META_TEMPLATE_NOME=

# Idioma do template (precisa bater com o aprovado).
META_TEMPLATE_IDIOMA=pt_BR

# Parâmetros do corpo do template, como CSV de campos do lead.
#   vazio            -> template SEM variáveis (é o caso do mkt_01)
#   nome,cidade      -> envia esses campos como {{1}}, {{2}}...
# ATENÇÃO: se o template tem variáveis e isto estiver vazio, a Meta RECUSA
# o envio com erro (#132000) "number of parameters does not match".
META_TEMPLATE_PARAMS=

# Timeout das chamadas à Meta (segundos).
META_TIMEOUT=30


# =============================================================================
# CHATWOOT - registro das campanhas (nota privada na conversa)
# =============================================================================
#
# PROBLEMA: quando a Meta entrega uma mensagem de saída, o webhook só manda
# `statuses` (sent/delivered/read) — NUNCA o conteúdo. Então o Chatwoot não
# tem como saber que a campanha foi enviada, e o atendente abre a conversa
# sem ver que o lead recebeu o template.
#
# SOLUÇÃO: após a Meta aceitar o envio, gravamos uma NOTA PRIVADA na conversa:
#     📤 Campanha enviada — template `mkt_01`
# O lead NÃO recebe nada (nota é interna).
#
# ⚠️ CUSTO: criar conversa para cada lead enche a caixa de entrada. Com 45 mil
# leads isso vira 45 mil conversas. Se quiser só anotar em quem já conversou,
# use CHATWOOT_CRIAR_CONVERSA=false.
CHATWOOT_REGISTRO_ATIVO=false

# URL da instância (sem barra no final).
CHATWOOT_URL=https://wps.agendamentoja.com

# Token de API: Chatwoot -> Perfil (avatar) -> Configurações -> Token de acesso.
CHATWOOT_API_TOKEN=

# ID da conta e do inbox (veja na URL: /app/accounts/{ID}/settings/inboxes/{ID})
CHATWOOT_ACCOUNT_ID=
CHATWOOT_INBOX_ID=

# true  = cria a conversa quando o lead ainda não tem nenhuma
# false = só anota em conversa existente (não polui a caixa de entrada)
CHATWOOT_CRIAR_CONVERSA=true

# Timeout das chamadas ao Chatwoot (segundos).
CHATWOOT_TIMEOUT=15


# =============================================================================
# WHATSAPP - WAHA (WhatsApp HTTP API) — BACKUP
# Usado apenas quando WHATSAPP_PROVIDER=waha
# =============================================================================

# URL base da sua instância WAHA (Docker local, por exemplo).
# Usada em todas as chamadas de envio. Não coloque a barra final.
WAHA_API_URL=http://localhost:3000

# Chave de API da WAHA. É o valor de WHATSAPP_API_KEY no .env do Docker/init-waha.
# Deixe vazio se a sua instância estiver sem autenticação.
WAHA_API_KEY=

# Nome da sessão do WhatsApp já conectada (lida por QR Code), normalmente `default`.
# Precisa ser exatamente o nome que aparece em /api/sessions da WAHA.
WAHA_SESSION=default

# Liga/desliga TODO o envio de WhatsApp.
#   true  = o menu "2 - Enviar mensagens WhatsApp" funciona normalmente.
#   false = o menu avisa que o envio está desativado e não faz nada.
# Isso NÃO afeta a coleta de leads, apenas o disparo de mensagens.
WAHA_ATIVO=true

# Atalho que pula o menu e vai direto para o envio, sem coletar nada.
#   true  = equivale a rodar: python src/main.py --so-enviar
#   false = abre o menu normal (coleta + envio).
# Útil para rodar uma campanha agendada, por exemplo.
SOMENTE_ENVIO=false

# Pausa em SEGUNDOS entre um envio e o próximo (13s ≈ 4-5 mensagens por minuto).
# Usado APENAS quando WAHA_CADENCIA está vazio (pausa fixa).
WAHA_INTERVALO=13

# Cadência de envio (anti-bloqueio): "X a cada Y segundos".
# Ex.: WAHA_CADENCIA=3:60  -> 3 envios por minuto, com intervalos ALEATÓRIOS
# (não manda de 15 em 15 segundos fixos). Tem prioridade sobre WAHA_INTERVALO.
# Deixe vazio para usar a pausa fixa do WAHA_INTERVALO.
WAHA_CADENCIA=

# Quantidade máxima de leads por campanha. Vazio = sem limite (envia todos
# os pendentes). Só conta leads celulares, ativos e ainda não enviados.
# ATENÇÃO: é por campanha (uma execução), NÃO por dia.
WAHA_LIMITE=

# Teto de envios por DIA, somando TODAS as campanhas (anti-bloqueio).
# Vazio ou 0 = sem teto diário.
# O contador é lido de whatsapp_envios_log (status='enviado'), então reiniciar
# o programa não zera: o dia continua de onde estava.
# Ex.: WAHA_LIMITE_DIA=150 -> no máximo 150 mensagens no dia.
WAHA_LIMITE_DIA=

# Horário permitido para envio: "INÍCIO-FIM".
#   vazio        = envia a qualquer hora
#   08:00-19:00  = só no horário comercial
#   22:00-06:00  = janela que atravessa a meia-noite
# Fora da janela o envio é bloqueado (inclusive o teste) e uma campanha em
# andamento é interrompida, deixando os leads restantes pendentes.
# O teto diário renova na abertura da janela (ex.: às 08:00), não à meia-noite.
WAHA_JANELA_ENVIO=08:00-19:00


# =============================================================================
# BASE DE LOCALIDADES (IBGE) - cache em DuckDB: tabelas localidades_*
# -----------------------------------------------------------------------------
# As duas flags abaixo são independentes. Combinações possíveis:
#
#   USAR_CACHE  SALVAR   O que acontece
#   true        true     usa o banco; só vai à API do que falta e grava (padrão)
#   false       true     ignora o banco, sempre vai à API e regrava (força refresh)
#   true        false    usa o banco; o que falta vai à API mas NÃO é gravado
#   false       false    sempre API, e o banco nunca é tocado (somente leitura)
# =============================================================================

# Consultar a base local ANTES da API do IBGE?
#   true  = se o dado já existe no DuckDB, nem chama a internet (rápido).
#   false = sempre chama a API do IBGE, mesmo que o dado já esteja no banco.
LOCALIDADES_USAR_CACHE=true

# Permitir GRAVAR na base local?
#   true  = pode inserir/atualizar (UPSERT) os estados, municípios e bairros.
#   false = modo somente leitura: nada é gravado e nem as tabelas são criadas.
# ATENÇÃO: com false, os menus "3 - Sincronizar" e "4 - Aquecer bairros" ficam
# desativados, e cada execução consulta as APIs de novo.
LOCALIDADES_SALVAR=true

# Mínimo de distritos do IBGE para considerar a cidade "coberta" pelo IBGE.
# A API de Localidades do IBGE tem distritos (não bairros). Cidade com menos
# distritos que este número é complementada com o OpenStreetMap.
# Exemplo: Campinas-SP tem 7 distritos -> usa só o IBGE.
#          Canoas-RS tem 1 distrito (a sede) -> vai para o OpenStreetMap.
LOCALIDADES_MIN_BAIRROS=3

# Pausa em SEGUNDOS entre cidades no menu "4 - Aquecer bairros de uma UF".
# Só é aplicada quando a cidade precisou do OpenStreetMap (Nominatim permite
# ~1 requisição por segundo). Cidades resolvidas pelo IBGE não esperam.
AQUECER_PAUSA_SEGUNDOS=2


# =============================================================================
# GOOGLE MAPS - captcha / bloqueio ("tráfego incomum")
# -----------------------------------------------------------------------------
# Quando o Google bloqueia, o robô pausa e tenta de novo. Se continuar bloqueado,
# ele aborta APENAS aquela área e mantém os leads já coletados.
# =============================================================================

# Quantas tentativas por página antes de desistir da área.
#   1  = não tenta de novo, só pausa uma vez e desiste.
#   2  = pausa e tenta mais uma vez (padrão).
# Valores altos aumentam o risco de piorar o bloqueio.
CAPTCHA_MAX_TENTATIVAS=2

# Pausa longa em SEGUNDOS feita pela thread que recebeu o captcha antes de
# tentar a mesma página novamente.
CAPTCHA_PAUSA_SEGUNDOS=300

# Pausa compartilhada em SEGUNDOS aplicada a TODAS as threads assim que uma
# delas detecta bloqueio (evita que as outras continuem martelando o Google).
CAPTCHA_PAUSA_GLOBAL_SEGUNDOS=180


# =============================================================================
# DESEMPENHO DO SCRAPER (CPU / memória)
# -----------------------------------------------------------------------------
# Cada Chromium é um processo pesado. Em VPS pequena (2 vCPU, por exemplo) o
# uso de CPU fica em 100% mesmo com 1 thread, porque o Chrome renderiza o Maps.
# Baixe SCRAPER_THREADS para 1 ou 2 se a máquina tiver pouca CPU.
# =============================================================================

# Navegadores em paralelo por cidade (padrão 3; mínimo 1).
SCRAPER_THREADS=3

# Bloquear imagens/mídia/fontes durante a coleta (padrão true).
# A extração é feita no DOM, então isso não afeta os dados e reduz muito a CPU.
# Coloque false apenas se notar que o Google Maps não carrega os resultados.
BLOQUEAR_RECURSOS=true

# Reciclar o Chromium a cada N áreas coletadas (padrão 40). Evita crescimento
# de memória em execuções de vários dias. Não é o número de threads.
MAX_CONTEXTOS_POR_NAVEGADOR=40


# =============================================================================
# COLETA AUTOMÁTICA (rodar em servidor/container, sem menu)
# -----------------------------------------------------------------------------
# Usadas pelo runner `python src/coleta_auto.py` (não-interativo). O Docker
# Compose já injeta estas variáveis com valores padrão; sobrescreva aqui ou no
# docker-compose.yml conforme necessário.
# =============================================================================

# Nicho a coletar no modo automático.
NICHO=barbearias

# UFs a coletar, separadas por vírgula. Vazio = TODAS as UFs do Brasil.
# Exemplo: UFS=RS,SP,RJ
UFS=

# Quantidade máxima de cidades por UF. 0 = todas. Aplicado DEPOIS de pular as
# cidades já concluídas (RETOMAR_COLETA).
MAX_CIDADES=0

# Quantidade máxima de bairros usados por cidade na busca (0 não é válido).
MAX_BAIRROS=30

# Pré-resolver (aquecer) os bairros da UF inteira antes de coletar?
#   true  = resolve e grava todos os bairros da UF antes (pode demorar).
#   false = resolve os bairros de cada cidade na hora da coleta (padrão).
AQUECER_BAIRROS=false

# Baixar estados/municípios/distritos do IBGE antes de coletar?
#   true  = útil em banco novo (DuckDB local). No PostgreSQL já populado, deixe
#           false para não rebaixar tudo do IBGE.
SINCRONIZAR=false

# Mostrar o navegador (Chromium) durante a coleta. Em servidor use false.
MOSTRAR_NAVEGADOR=false

# Gerar Excel por cidade ao final de cada coleta (true/false).
EXPORTAR_EXCEL=false

# Rodar em loop contínuo (true) ou executar um único ciclo (false).
LOOP=false

# Pausa (segundos) entre ciclos quando LOOP=true.
LOOP_PAUSA_SEGUNDOS=3600

# Retomar de onde parou: pula as cidades já concluídas (gravadas em
# `coleta_progresso`). Com true, parar/reiniciar o container NÃO recomeça o
# país do zero. Com false, volta ao comportamento antigo (todo ciclo refaz tudo).
RETOMAR_COLETA=true

# Refazer as cidades concluídas há mais de N dias (padrão 30). 0 = nunca refazer.
RECAPTURA_DIAS=30

# Na primeira execução com RETOMAR_COLETA=true e `coleta_progresso` vazia,
# marcar como concluídas as cidades que já têm leads no banco (evita recomeçar
# uma coleta que já estava rodando antes deste recurso existir).
SEMEAR_PROGRESSO=true
