# ===== Configuração da WAHA (WhatsApp HTTP API) =====
# Copie este arquivo para `.env` e preencha com os seus valores reais.
# O arquivo `.env` NÃO deve ser versionado no Git (contém a API key).

# URL base da sua instância WAHA
WAHA_API_URL=http://localhost:3000

# Chave de API gerada pelo `init-waha` (arquivo .env do Docker)
WAHA_API_KEY=

# Nome da sessão conectada (padrão: default)
WAHA_SESSION=default

# Tentar enviar mensagens? (true/false)
# false = desliga o envio de WhatsApp completamente
WAHA_ATIVO=true

# Pular a coleta e ir direto para o envio? (true/false)
# true = NÃO coleta nada, só envia os WhatsApp pendentes
SOMENTE_ENVIO=false

# Intervalo em segundos entre envios (evita spam/banimento)
WAHA_INTERVALO=13

# Quantidade máxima de leads por campanha (vazio = sem limite)
WAHA_LIMITE=
