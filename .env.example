# ===== Configuração da WAHA (WhatsApp HTTP API) =====
# Copie este arquivo para `.env` e preencha com os seus valores reais.
# O arquivo `.env` NÃO deve ser versionado no Git (contém a API key).

# URL base da sua instância WAHA
WAHA_API_URL=http://localhost:3000

# Chave de API gerada pelo `init-waha` (arquivo .env do Docker)
WAHA_API_KEY=

# Nome da sessão conectada (padrão: default)
WAHA_SESSION=default

# Tentar enviar mensagens? (true/false)
# false = desliga o envio de WhatsApp completamente
WAHA_ATIVO=true

# Pular a coleta e ir direto para o envio? (true/false)
# true = NÃO coleta nada, só envia os WhatsApp pendentes
SOMENTE_ENVIO=false

# Intervalo em segundos entre envios (evita spam/banimento)
WAHA_INTERVALO=13

# Quantidade máxima de leads por campanha (vazio = sem limite)
WAHA_LIMITE=

# ===== Base de localidades (IBGE) =====
# true  = consulta o DuckDB primeiro e só vai à API quando falta dado (recomendado)
# false = sempre busca na API do IBGE (e atualiza a base local com o resultado)
LOCALIDADES_USAR_CACHE=true

# true  = pode gravar na base local (UPSERT das tabelas localidades_*)
# false = NUNCA grava nada: a base fica somente leitura (nem tabelas são criadas)
LOCALIDADES_SALVAR=true

# Mínimo de distritos do IBGE para dispensar o OpenStreetMap.
# Cidades com menos distritos úteis são complementadas com bairros do OSM.
LOCALIDADES_MIN_BAIRROS=3

# ===== Google Maps: captcha / bloqueio =====
# Quantas vezes a mesma página é tentada ao detectar captcha (1 = não tenta de novo)
CAPTCHA_MAX_TENTATIVAS=2

# Pausa longa (segundos) da thread que recebeu o captcha antes de tentar de novo
CAPTCHA_PAUSA_SEGUNDOS=300

# Pausa compartilhada (segundos) aplicada a TODAS as threads quando uma detecta bloqueio
CAPTCHA_PAUSA_GLOBAL_SEGUNDOS=180
